{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd factory-planner-front && npm run dev"],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd factory-planner-backend && ./venv/bin/uvicorn app.main:app --reload --port 8000"],
      "port": 8000
    }
  ]
}
