# Путь к обычной (Steam) копии Factorio — откуда брать иконки и графику
FACTORIO_GAME_PATH=D:\Factorio1

# Путь к отдельной headless-инсталляции (для --dump-data)
FACTORIO_HEADLESS_PATH=D:\FactorioHeadless

# Путь к папке модов, которую видит headless (можно совпадать с игровой)
FACTORIO_MODS_PATH=D:\Factorio1\mods

DATABASE_URL=sqlite:///./data/factory_planner.db

# Только для Linux, если FACTORIO_GAME_PATH указывает на Windows-сборку (.exe):
# путь к бинарю wine/wine64 и к Wine-префиксу, в котором запускается игра.
# Если не заданы — ищутся автоматически по стандартным путям PortProton.
# WINE_BINARY_PATH=/home/user/PortProton/data/dist/PROTON_LG_10-28/bin/wine64
# WINE_PREFIX_PATH=/home/user/PortProton/data/prefixes/DEFAULT