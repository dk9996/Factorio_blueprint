# Путь к обычной (Steam) копии Factorio — откуда брать иконки и графику
FACTORIO_GAME_PATH=D:\Factorio1

# Путь к отдельной headless-инсталляции (для --dump-data)
FACTORIO_HEADLESS_PATH=D:\FactorioHeadless

# Путь к папке модов, которую видит headless (можно совпадать с игровой)
FACTORIO_MODS_PATH=D:\Factorio1\mods

DATABASE_URL=sqlite:///./data/factory_planner.db