# Скопируйте в .env (cp .env.example .env), заполните и ограничьте права:
#   chmod 600 .env
# .env в .gitignore — реальные секреты в репозиторий не попадают.
# Подробно: DEPLOY.md.

# --- Домен и origin ---------------------------------------------------
# Caddy получит для этого домена сертификат Let's Encrypt автоматически.
PUBLIC_DOMAIN=factory-planner.duckdns.org
ORIGIN=https://factory-planner.duckdns.org

# --- Postgres ---------------------------------------------------------
# Сгенерировать: openssl rand -hex 24   (только hex — безопасно для URL)
POSTGRES_PASSWORD=
# Тот же пароль, что выше (compose подставит ${POSTGRES_PASSWORD}).
DATABASE_URL=postgresql://factory_planner:${POSTGRES_PASSWORD}@postgres:5432/factory_planner

# --- Приложение -------------------------------------------------------
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Смена SECRET_KEY разлогинит всех пользователей.
SECRET_KEY=
# Сторонние моды — задел на будущее, держать false.
MODS_ENABLED=false
# Секьюрные cookie (нужен HTTPS; на проде всегда true).
COOKIE_SECURE=true
# Путь к контенту ВНУТРИ контейнера (compose монтирует ./content сюда).
# Задан в docker-compose.yml — менять не нужно, оставлено для ясности.
CONTENT_DIR=/content
